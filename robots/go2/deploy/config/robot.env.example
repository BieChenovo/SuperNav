# Copy to robot.env; this file is sourced by Bash. Do not put secrets here.
# Required: robot address and GoPro serials in FRONT RIGHT BACK LEFT order.
UNITREE_GO2_IP=CHANGE_ME
DIMOS_GOPRO_SERIALS="FRONT_SERIAL RIGHT_SERIAL BACK_SERIAL LEFT_SERIAL"

# Default: headless map-backed PixelGoal; 1008 is also supported.
DIMOS_GO2_MOVE_API=joystick
SUPERNAV_RERUN=0
# Only used with Rerun enabled; set to the actual browser origin.
SUPERNAV_RERUN_CORS_ORIGIN=http://127.0.0.1:9878

# HERO8 Linear: baseline calibration for 1280x720 output.
# Recalibrate for another camera, FOV, mount or image transform.
DIMOS_PIXELGOAL_MAP_FX=611
DIMOS_PIXELGOAL_MAP_FY=614
DIMOS_PIXELGOAL_MAP_CX=640
DIMOS_PIXELGOAL_MAP_CY=360
DIMOS_PIXELGOAL_MAP_CALIBRATION_WIDTH=1280
DIMOS_PIXELGOAL_MAP_CALIBRATION_HEIGHT=720
DIMOS_PIXELGOAL_MAP_BASE_HEIGHT_M=0.30
DIMOS_PIXELGOAL_MAP_MOUNT_FRONT_YAW_DEG=0
DIMOS_PIXELGOAL_MAP_MOUNT_RIGHT_YAW_DEG=-90
DIMOS_PIXELGOAL_MAP_MOUNT_BACK_YAW_DEG=180
DIMOS_PIXELGOAL_MAP_MOUNT_LEFT_YAW_DEG=90
DIMOS_PIXELGOAL_MAP_MOUNT_FRONT_HEIGHT_M=0.60
DIMOS_PIXELGOAL_MAP_MOUNT_RIGHT_HEIGHT_M=0.60
DIMOS_PIXELGOAL_MAP_MOUNT_BACK_HEIGHT_M=0.60
DIMOS_PIXELGOAL_MAP_MOUNT_LEFT_HEIGHT_M=0.60
DIMOS_PIXELGOAL_MAP_MOUNT_FRONT_PITCH_DEG=0
DIMOS_PIXELGOAL_MAP_MOUNT_RIGHT_PITCH_DEG=0
DIMOS_PIXELGOAL_MAP_MOUNT_BACK_PITCH_DEG=0
DIMOS_PIXELGOAL_MAP_MOUNT_LEFT_PITCH_DEG=0

DIMOS_GOPRO_DECODER=h264_nvv4l2dec
DIMOS_GOPRO_SOURCE_RES=480
DIMOS_GOPRO_FPS=15
DIMOS_GOPRO_START_DELAY_S=5

# Operator model; choose a model available to your account.
SUPERNAV_MODEL=gpt-5.6-sol
SUPERNAV_REASONING_EFFORT=high
