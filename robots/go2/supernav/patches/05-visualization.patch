+def _topic_filter_values(bridge: "RerunBridgeModule", topic: Any) -> set[str]:
+    topic_str = getattr(topic, "name", None) or str(topic)
+    topic_base = topic_str.split("#", 1)[0]
+    values = {topic_str, topic_base, bridge._get_entity_path(topic)}
+    if topic_base.startswith("/"):
+        values.add(topic_base[1:])
+    return values
+
+
+def _matches_any_filter(patterns: tuple[str, ...], values: set[str]) -> bool:
+    return any(
+        pattern_matches(Glob(pattern), value)
+        if any(ch in pattern for ch in "*?")
+        else pattern_matches(pattern, value)
+        for pattern in patterns
+        for value in values
+    )
+
