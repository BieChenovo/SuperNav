+class _RerunOutbox:
+    """Bounded, latest-wins outbox between pubsub subscribers and ``rr.log``.
+
+    Subscriber threads only enqueue raw messages (a cheap dict replace). A
+    single drain thread converts and logs them. A monitor thread periodically
+    flushes the SDK pipeline; when the flush times out, the sink is stalled
+    (slow network/viewer) and the drain pauses so no new data enters the
+    SDK's unbounded internal buffer. Pending messages coalesce to the newest
+    per entity, so memory stays bounded no matter how long the stall lasts.
+    """
+
+    def __init__(
+        self,
+        log_fn: Callable[[str, Any], None],
+        *,
+        flush_interval_s: float,
+        flush_timeout_s: float,
+    ) -> None:
+        self._log_fn = log_fn
+        self._flush_interval_s = flush_interval_s
+        self._flush_timeout_s = flush_timeout_s
+        self._pending: dict[str, tuple[str, Any]] = {}
+        self._cond = threading.Condition()
+        self._stop = threading.Event()
+        self.stalled = threading.Event()
+        self.submitted = 0
+        self.coalesced = 0
+        self.logged = 0
+        self._drain_thread: threading.Thread | None = None
+        self._monitor_thread: threading.Thread | None = None
+
+    @property
+    def pending_count(self) -> int:
+        with self._cond:
+            return len(self._pending)
+
+    def start(self) -> None:
+        self._drain_thread = threading.Thread(
+            target=self._drain_loop, name="rerun-outbox-drain", daemon=True
+        )
+        self._monitor_thread = threading.Thread(
+            target=self._monitor_loop, name="rerun-outbox-monitor", daemon=True
+        )
+        self._drain_thread.start()
+        self._monitor_thread.start()
+
+    def stop(self) -> None:
+        self._stop.set()
+        with self._cond:
+            self._pending.clear()
+            self._cond.notify_all()
+        for thread in (self._drain_thread, self._monitor_thread):
+            if thread is not None:
+                thread.join(timeout=2.0)
+        self._drain_thread = None
+        self._monitor_thread = None
+
+    def submit(self, entity_path: str, msg: Any) -> None:
+        """Enqueue a raw message, replacing any unconsumed message for the entity."""
+        with self._cond:
+            if entity_path in self._pending:
+                self.coalesced += 1
+            self._pending[entity_path] = (entity_path, msg)
+            self.submitted += 1
+            self._cond.notify()
+
+    def _take_batch(self) -> list[tuple[str, Any]]:
+        with self._cond:
+            while not self._stop.is_set():
+                if self._pending and not self.stalled.is_set():
+                    batch = list(self._pending.values())
+                    self._pending.clear()
+                    return batch
+                self._cond.wait(timeout=0.5)
+            return []
+
+    def _log_batch(self, batch: list[tuple[str, Any]]) -> int:
+        logged = 0
+        for entity_path, msg in batch:
+            try:
+                self._log_fn(entity_path, msg)
+                logged += 1
+            except Exception:  # one bad message must not kill the drain thread
+                logger.warning("rerun outbox failed to log %s", entity_path, exc_info=True)
+        self.logged += logged
+        return logged
+
+    def drain_pending(self) -> int:
+        """Log one pending batch synchronously (no-op while stalled). For tests."""
+        if self.stalled.is_set():
+            return 0
+        with self._cond:
+            batch = list(self._pending.values())
+            self._pending.clear()
+        return self._log_batch(batch)
+
+    def _drain_loop(self) -> None:
+        while not self._stop.is_set():
+            self._log_batch(self._take_batch())
+
+    def monitor_step(self) -> bool:
+        """Probe the SDK pipeline once; False means the sink is stalled. For tests."""
+        recording = rr.get_global_data_recording()
+        try:
+            recording.flush(timeout_sec=self._flush_timeout_s)
+        except Exception:  # noqa: BLE001 — any flush failure means the sink is unhealthy
+            return False
+        return True
+
+    def _on_probe_result(self, healthy: bool) -> None:
+        if healthy and self.stalled.is_set():
+            self.stalled.clear()
+            logger.info(
+                "rerun sink recovered, resuming feed (pending=%d coalesced=%d)",
+                self.pending_count,
+                self.coalesced,
+            )
+            with self._cond:
+                self._cond.notify_all()
+        elif not healthy and not self.stalled.is_set():
+            self.stalled.set()
+            logger.warning(
+                "rerun sink stalled (flush did not complete within %.1fs); "
+                "pausing feed and coalescing to latest per entity to bound memory",
+                self._flush_timeout_s,
+            )
+
+    def _monitor_loop(self) -> None:
+        while not self._stop.wait(self._flush_interval_s):
+            self._on_probe_result(self.monitor_step())
+
