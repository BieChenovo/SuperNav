+def _finite_float(value: Any, *, default: float | None = None) -> float:
+    if value is None:
+        if default is None:
+            raise ValueError("required numeric field is null")
+        return default
+    result = float(value)
+    if not math.isfinite(result):
+        raise ValueError("numeric field must be finite")
+    return result
