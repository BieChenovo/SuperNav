+class OfflineRerunRecorder:
+    """Record pubsub messages to a .rrd file without starting live Rerun transports."""
+
+    def __init__(
+        self,
+        *,
+        out: str | Path,
+        bridge: "RerunBridgeModule",
+        include: tuple[str, ...] = (),
+        exclude: tuple[str, ...] = (),
+    ) -> None:
+        self.out = Path(out)
+        self.bridge = bridge
+        self.include = include
+        self.exclude = exclude
+        self._unsubscribes: list[Callable[[], None]] = []
+        self._started_pubsubs: list[Any] = []
+        self._started = False
+
+    def start(self) -> None:
+        if self._started:
+            return
+        self.out.parent.mkdir(parents=True, exist_ok=True)
+        self.bridge._last_log = {}
+        self.bridge._frame_attached = {}
+        self.bridge._min_intervals = {
+            entity: 1.0 / hz for entity, hz in self.bridge.config.max_hz.items() if hz > 0
+        }
+
+        rerun_init("dimos-rerun-record", start_grpc=False)
+        rr.save(str(self.out))
+        self._started = True
+        if self.bridge.config.blueprint:
+            rr.send_blueprint(_with_graph_tab(self.bridge.config.blueprint()))
+
+        for pubsub in self.bridge.config.pubsubs:
+            logger.info(f"recording Rerun data from {pubsub.__class__.__name__}")
+            if hasattr(pubsub, "start"):
+                pubsub.start()
+                self._started_pubsubs.append(pubsub)
+            self._unsubscribes.append(pubsub.subscribe_all(self._on_message))
+
+        self.bridge._log_static()
+
+    def stop(self) -> None:
+        if not self._started:
+            return
+        try:
+            for unsubscribe in reversed(self._unsubscribes):
+                unsubscribe()
+            for pubsub in reversed(self._started_pubsubs):
+                if hasattr(pubsub, "stop"):
+                    pubsub.stop()
+        finally:
+            self._unsubscribes.clear()
+            self._started_pubsubs.clear()
+            self.bridge._override_cache.clear()
+            self.bridge._frame_attached.clear()
+            rr.rerun_shutdown()
+            self._started = False
+
+    def _on_message(self, msg: Any, topic: Any) -> None:
+        values = _topic_filter_values(self.bridge, topic)
+        if self.include and not _matches_any_filter(self.include, values):
+            return
+        if self.exclude and _matches_any_filter(self.exclude, values):
+            return
+        self.bridge._on_message(msg, topic)
+
+
+def run_recording(
+    out: str | Path,
+    *,
+    include: tuple[str, ...] = (),
+    exclude: tuple[str, ...] = (),
+    max_hz: dict[str, float] | None = None,
+    memory_limit: str = "25%",
+) -> Path:
+    """Record Rerun data to a .rrd file until interrupted by the user."""
+    autoconf(check_only=True)
+
+    out_path = Path(out)
+    bridge = RerunBridgeModule(
+        memory_limit=memory_limit,
+        max_hz=max_hz or {},
+        pubsubs=[LCM()],
+    )
+    recorder = OfflineRerunRecorder(
+        out=out_path,
+        bridge=bridge,
+        include=include,
+        exclude=exclude,
+    )
+
+    should_stop = False
+
+    def _shutdown(*_: object) -> None:
+        nonlocal should_stop
+        should_stop = True
+
+    old_sigint = signal.getsignal(signal.SIGINT)
+    old_sigterm = signal.getsignal(signal.SIGTERM)
+    signal.signal(signal.SIGINT, _shutdown)
+    signal.signal(signal.SIGTERM, _shutdown)
+    try:
+        recorder.start()
+        print(f"Recording Rerun data to {out_path}")
+        while not should_stop:
+            signal.pause()
+    finally:
+        recorder.stop()
+        signal.signal(signal.SIGINT, old_sigint)
+        signal.signal(signal.SIGTERM, old_sigterm)
+    print(f"Wrote {out_path}")
+    return out_path
+
