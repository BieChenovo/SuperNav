+    def _drive_residual_distance_m(
+        self, current_pose: PoseStamped, goal_pose: PoseStamped
+    ) -> float:
+        dx = goal_pose.position.x - current_pose.position.x
+        dy = goal_pose.position.y - current_pose.position.y
+        return math.hypot(dx, dy)
