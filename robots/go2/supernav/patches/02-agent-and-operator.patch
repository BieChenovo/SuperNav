+def _normalize_mcp_content_blocks(blocks: list[dict[str, Any]]) -> list[dict[str, Any]]:
+    """Normalize provider image blocks into MCP image content blocks.
+
+    Native DimOS and LangChain paths use provider-specific image shapes such as
+    OpenAI ``image_url`` or Responses ``input_image``. External MCP clients such
+    as Codex expect MCP image content: ``{"type": "image", "data": "...",
+    "mimeType": "..."}``. Keep that impedance match at the MCP boundary.
+    """
+
+    normalized: list[dict[str, Any]] = []
+    for block in blocks:
+        if not is_image_block(block):
+            normalized.append(block)
+            continue
+        normalized.append(_to_mcp_image_content_block(block) or block)
+    return normalized
+
+
+def _to_mcp_image_content_block(block: dict[str, Any]) -> dict[str, Any] | None:
+    data_url = image_block_data_url(block)
+    if data_url is None or ";base64," not in data_url:
+        return None
+    data = data_url.split(";base64,", 1)[1]
+    mime_type = image_block_mime_type(block) or "image/jpeg"
+    return {
+        "type": "image",
+        "data": data,
+        "mimeType": mime_type,
+    }
+
