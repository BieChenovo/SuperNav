+def _read_image_artifact(
+    artifact_id: str, runtime_config: Any | None
+) -> ImageArtifactReadback | SkillResult[str]:
+    """Read a persisted image artifact for MCP/native harness clients."""
+
+    artifact_id = str(artifact_id or "").strip()
+    if not is_valid_artifact_id(artifact_id):
+        return SkillResult.fail(
+            "INVALID_INPUT",
+            "Invalid artifact id. Expected an id like artifact_000001.",
+            artifact_id=artifact_id,
+        )
+
+    artifact_dir = resolve_artifact_dir(runtime_config=runtime_config)
+    if artifact_dir is None:
+        return SkillResult.fail(
+            "NOT_CONFIGURED",
+            "No artifact directory is configured for this DimOS run.",
+            artifact_id=artifact_id,
+        )
+
+    ledger = ArtifactLedger(artifact_dir=artifact_dir)
+    ref = ledger.get_ref(artifact_id)
+    block = ledger.get_block(artifact_id)
+    if ref is None or block is None:
+        return SkillResult.fail(
+            "NOT_FOUND",
+            f"Artifact '{artifact_id}' was not found in {artifact_dir}.",
+            artifact_id=artifact_id,
+            artifact_dir=str(artifact_dir),
+        )
+    if not is_image_block(block):
+        return SkillResult.fail(
+            "NOT_IMAGE",
+            f"Artifact '{artifact_id}' is not an image artifact.",
+            artifact_id=artifact_id,
+            artifact_dir=str(artifact_dir),
+            kind=ref.kind,
+        )
+    return ImageArtifactReadback(ref=ref, block=block)
