+    """Preempt active movement authority for client ids and issue stop tools."""
+
+    leases: MovementLeaseManager = app.state.movement_leases
+    preempted: list[MovementLease] = []
+    seen: set[str] = set()
+    for client_id in client_ids:
+        if client_id in seen:
+            continue
+        seen.add(client_id)
+        lease = leases.preempt(client_id)
+        if lease is None:
+            continue
+        preempted.append(lease)
+        _preempt_movement_lease(lease, preempted_by=preempted_by)
+    return preempted
