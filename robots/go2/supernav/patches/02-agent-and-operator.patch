+def _call_tool_rpc(tool_name: str, rpc_call: Any, call_kwargs: dict[str, Any]) -> Any:
+    if tool_name not in STATUS_READ_TOOLS:
+        return rpc_call(**call_kwargs)
+
+    try:
+        result = _call_rpc_with_timeout(
+            rpc_call,
+            timeout_s=STATUS_READ_TIMEOUT_S,
+            call_kwargs=call_kwargs,
+            thread_name=f"McpServer-status-{tool_name}",
+            timeout_message=f"Status tool '{tool_name}' timed out after {STATUS_READ_TIMEOUT_S:.1f}s",
+        )
+    except TimeoutError as e:
+        return _status_read_timeout_result(tool_name, e)
+    _remember_status_read_result(tool_name, result)
+    return result
+
+
+def _task_context_from_meta(meta: dict[str, Any]) -> dict[str, Any] | None:
+    task_id = meta.get("dimos/task_id")
+    task_goal = meta.get("dimos/task_goal")
+    if task_id is None and task_goal is not None:
+        client_id = meta.get("dimos/client_id") or "external"
+        task_id = (
+            f"external_{_compact_meta_token(str(client_id))}_"
+            f"{_compact_meta_token(str(task_goal))}"
+        )
+    if task_id is None:
+        return None
+    context: dict[str, Any] = {"task_id": str(task_id)}
+    for meta_key, context_key in (
+        ("dimos/task_goal", "task_goal"),
+        ("dimos/task_origin", "task_origin"),
+    ):
+        value = meta.get(meta_key)
+        if value is not None:
+            context[context_key] = str(value)
+    return context
+
+
+def _compact_meta_token(value: str) -> str:
+    token = "".join(ch if ch.isalnum() or ch in {"_", "-"} else "_" for ch in value.strip())
+    return token[:48] or "task"
+
+
+def _remember_status_read_result(tool_name: str, result: Any) -> None:
+    cache: dict[str, tuple[float, Any]] = app.state.status_read_cache
+    cache[tool_name] = (time.monotonic(), result)
+
+
+def _status_read_timeout_result(tool_name: str, error: TimeoutError) -> SkillResult[str]:
+    metadata: dict[str, Any] = {
+        "tool_name": tool_name,
+        "timed_out": True,
+        "timeout_s": STATUS_READ_TIMEOUT_S,
+        "error": str(error),
+    }
+    cache: dict[str, tuple[float, Any]] = app.state.status_read_cache
+    cached = cache.get(tool_name)
+    if cached is not None:
+        cached_at, cached_result = cached
+        cache_age_s = round(time.monotonic() - cached_at, 1)
+        metadata["cache_age_s"] = cache_age_s
+        metadata["cached_result"] = _status_cached_result_payload(cached_result)
+        message = (
+            f"Status tool '{tool_name}' timed out after {STATUS_READ_TIMEOUT_S:.1f}s; "
+            f"returning cached result age={cache_age_s:.1f}s."
+        )
+    else:
+        metadata["cache_age_s"] = None
+        metadata["partial_result"] = {"tool_name": tool_name, "status": "timeout"}
+        message = (
+            f"Status tool '{tool_name}' timed out after {STATUS_READ_TIMEOUT_S:.1f}s; "
+            "no cached result is available."
+        )
+    return SkillResult.fail("EXECUTION_TIMEOUT", message, **metadata)
+
+
+def _status_cached_result_payload(result: Any) -> dict[str, Any]:
+    if isinstance(result, SkillResult):
+        payload: dict[str, Any] = {
+            "kind": "SkillResult",
+            "success": result.success,
+            "message": result.message,
+            "error_code": result.error_code,
+        }
+        if result.metadata:
+            payload["metadata"] = result.metadata
+        return payload
+    return {"kind": result.__class__.__name__, "text": str(result)[:2000]}
+
