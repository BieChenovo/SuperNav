+def _movement_lease_authorization(
+    tool_name: str,
+    args: dict[str, Any],
+    uses: list[str],
+    meta: dict[str, Any],
+) -> tuple[str | None, MovementLeaseTicket | None]:
+    if is_stop_tool(tool_name) or not is_movement_tool(tool_name, uses):
+        return None, None
+
+    client_id = _movement_lease_client_id(meta)
+    leases: MovementLeaseManager = app.state.movement_leases
+    grant_request = movement_authority_request_from_meta(
+        meta,
+        client_id=client_id,
+        fallback_task=f"{tool_name}({args})",
+    )
+    if grant_request.confirmed:
+        token_refusal = _consume_movement_grant_token(
+            tool_name=tool_name,
+            args=args,
+            request=grant_request,
+            event_name="movement_lease_refused",
+        )
+        if token_refusal is not None:
+            return token_refusal, None
+
+        expired_lease = leases.preempt_expired(client_id)
+        if expired_lease is not None:
+            _preempt_movement_lease(expired_lease, preempted_by="authority_expired")
+
+        lease = leases.grant(
+            client_id=client_id,
+            task=grant_request.task,
+            max_duration_s=(
+                PIXELGOAL_MOVEMENT_LEASE_DURATION_S if tool_name == "pixelgoal_navigate" else 60.0
+            ),
+        )
+        emit_trace_event(
+            logger,
+            "movement_lease_created",
+            client_id=client_id,
+            lease_id=lease.lease_id,
+            epoch=lease.epoch,
+            task=lease.task,
+            remaining=lease.remaining(),
+            grant_token_present=grant_request.token_present,
+        )
+        logger.info(
+            "Movement lease granted",
+            client_id=client_id,
+            lease_id=lease.lease_id,
+            epoch=lease.epoch,
+            task=lease.task,
+        )
+
+    authorization = leases.consume_authorization(
+        client_id=client_id,
+        tool_name=tool_name,
+        args=args,
+    )
+    allowed = authorization.allowed
+    reason = authorization.reason
+    lease = authorization.lease
+    cost = authorization.cost
+    if allowed:
+        assert lease is not None and authorization.ticket is not None
+        emit_trace_event(
+            logger,
+            "movement_lease_consumed",
+            client_id=client_id,
+            lease_id=lease.lease_id,
+            epoch=lease.epoch,
+            tool_name=tool_name,
+            cost=cost.model_dump(),
+            remaining=lease.remaining(),
+            ticket=authorization.ticket.model_dump(),
+        )
+        logger.info(
+            "Movement lease consumed",
+            client_id=client_id,
+            lease_id=lease.lease_id,
+            epoch=lease.epoch,
+            tool=tool_name,
+            cost=cost.model_dump(),
+            remaining=lease.remaining(),
+        )
+        return None, authorization.ticket
+
+    if lease is None:
+        emit_trace_event(
+            logger,
+            "movement_lease_refused",
+            client_id=client_id,
+            tool_name=tool_name,
+            reason="No active movement lease.",
+            cost=cost.model_dump(),
+        )
+        return (
+            f"Runtime movement policy is lease. Tool '{tool_name}' was not executed "
+            "because there is no active movement lease. Ask the user to confirm a "
+            "bounded movement task, then retry."
+        ), None
+    emit_trace_event(
+        logger,
+        "movement_lease_refused",
+        client_id=client_id,
+        lease_id=lease.lease_id,
+        epoch=lease.epoch,
+        tool_name=tool_name,
+        reason=reason,
+        cost=cost.model_dump(),
+        remaining=lease.remaining(),
+    )
+    return (
+        f"Runtime movement policy is lease. Tool '{tool_name}' was not executed: "
+        f"{reason} Remaining budget: {lease.remaining()}."
+    ), None
+
